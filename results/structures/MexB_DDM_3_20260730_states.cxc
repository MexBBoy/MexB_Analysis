# ChimeraX: open this file, keeping it beside
#   MexB_DDM_3_20260730_states.pdb and MexB_DDM_3_20260730_states.bild
open MexB_DDM_3_20260730_states.pdb
hide atoms
show cartoon
color #1/D #0A9DA0   # Access
color #1/E #CA0FC1   # Binding
color #1/F #0F9C1B   # Extrusion
transparency #1 70 target c
open MexB_DDM_3_20260730_states.bild
# chain D [Access]: CH1 - PC1/PC2 periplasmic cleft
# chain E [Binding]: CH1 - PC1/PC2 periplasmic cleft
# chain F [Extrusion]: CH3 - PN1/PN2 groove
select ligand
style sel ball
color sel byhetero
~select
set bgColor white
lighting soft
graphics silhouettes true
view
