# ChimeraX: open this file, keeping it beside
#   MexB_DDM_3_20260730_overlay.pdb and MexB_DDM_3_20260730_overlay.bild
open MexB_DDM_3_20260730_overlay.pdb
hide atoms
show cartoon
color #1 #D6DEE2
transparency #1 55 target c
open MexB_DDM_3_20260730_overlay.bild
# chain D [Access]: CH1 - PC1/PC2 periplasmic cleft
# chain E [Binding]: CH1 - PC1/PC2 periplasmic cleft
# chain F [Extrusion]: CH3 - PN1/PN2 groove
select ligand
style sel ball
color sel byhetero
~select
set bgColor white
lighting soft
graphics silhouettes true
view
